+    calls = {"len": 0, "getitem": 0, "setitem": 0}
+
+    class SpyList(list):
+        def __len__(self):
+            calls["len"] += 1
+            return super().__len__()
+
+        def __getitem__(self, index):
+            calls["getitem"] += 1
+            return super().__getitem__(index)
+
+        def __setitem__(self, index, value):
+            calls["setitem"] += 1
+            return super().__setitem__(index, value)
